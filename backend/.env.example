# Copy to backend/.env and edit as needed. Nothing here is secret.

# Folder containing the QoL_Stress CSV files. Default: ../data/qol_stress if it exists,
# otherwise the unpacked PhysioNet folder next to backend/ (…-1.0.0/data).
# QOL_STRESS_DIR=C:\path\to\qol_stress\data

# Application database, model artifacts and upload folders
# APP_DB_PATH=data/app.db
# ARTIFACT_DIR=artifacts
# UPLOAD_DIR=data/uploads

# Only this origin may call the API from a browser
FRONTEND_ORIGIN=http://localhost:3000

# Keep the original screenshot files after confirmation (default false: only file name + SHA-256 are kept)
STORE_SCREENSHOTS=false

# Full path to tesseract.exe if it is not on PATH or in C:\Program Files\Tesseract-OCR
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Reproducibility
RANDOM_SEED=42
CV_FOLDS=5

# Segmentation protocol (see docs/METHODOLOGY.md). Changing these changes every experiment.
CALIBRATION_MINUTES=3
GUARD_BEFORE_STAI_MINUTES=2
GUARD_AFTER_RELAX_STAI_MINUTES=1
WINDOW_SECONDS=60
MIN_SAMPLES_PER_WINDOW=15
MIN_CALIBRATION_SAMPLES=45
MIN_PHASE_MINUTES=3
SEGMENT_MINUTES=5
